<?xml version="1.0" encoding="utf-8"?>
<!-- Scan QR via la camera (porte depuis ElegooRFID le 10/10/2026, voir ScanQrActivity.kt) :
     FrameLayout plutot que le ScrollView habituel des autres ecrans - la camera (PreviewView)
     doit remplir tout l'ecran, avec juste un bandeau superpose par-dessus pour le bouton retour
     et l'instruction. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewScanQr"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#88000000"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnFermerScanQr"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Fermer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Vise le QR de l'étiquette"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
