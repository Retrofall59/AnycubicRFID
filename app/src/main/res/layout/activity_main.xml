<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tete avec logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_bobine"
                android:contentDescription="Logo bobine" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="AnycubicRFID"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texte_principal" />

            <ImageButton
                android:id="@+id/btnParametres"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_parametres"
                android:contentDescription="Parametres" />
        </LinearLayout>

        <!-- Bandeau affiche uniquement quand le NFC est desactive dans les reglages du telephone -->
        <Button
            android:id="@+id/btnReglagesNfc"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fond_bouton_principal"
            android:text="NFC désactivé - ouvrir les réglages"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Carte principale de resultat, avec vraie ombre portee -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:background="@drawable/barre_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/imgNfc"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_nfc"
                        android:contentDescription="Icone NFC"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:id="@+id/vuCouleur"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone"
                        android:background="@drawable/forme_couleur" />

                    <TextView
                        android:id="@+id/txtStatut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Approche une bobine Anycubic du dos du telephone..."
                        android:textColor="@color/texte_principal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginBottom="4dp" />

                    <!-- Lignes d'infos avec icones, remplies dynamiquement -->
                    <LinearLayout
                        android:id="@+id/layoutLignesInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnImprimerEtiquette"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fond_bouton_principal"
            android:text="Imprimer l'étiquette"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnExporter"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Exporter le dernier dump"
            android:textColor="@color/anycubic_noir"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="3">

            <Button
                android:id="@+id/btnCopier"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Copier"
                android:textColor="@color/anycubic_noir"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPartager"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Partager"
                android:textColor="@color/anycubic_noir"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHistorique"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Historique"
                android:textColor="@color/anycubic_noir"
                android:textAllCaps="false"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRapportCompat"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Copier le rapport de compatibilité"
            android:textColor="@color/anycubic_noir"
            android:textAllCaps="false"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
