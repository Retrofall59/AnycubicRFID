<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/btnRetourImportBase"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Retour" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Importer depuis une base de données"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/texte_principal" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fond_carte"
            android:padding="10dp"
            android:text="Choisis un ou plusieurs fichiers JSON de base de filaments (un par fabricant). Les matières, couleurs ou gammes que le format Anycubic ne peut pas représenter (dégradé, matière inconnue, température ou longueur absente...) sont grisées plutôt que deviner."
            android:textColor="@color/texte_secondaire"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnChoisirFichiersBase"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/fond_bouton_principal"
            android:text="Choisir des fichiers JSON"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtStatutBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Aucun fichier chargé pour l'instant."
            android:textColor="@color/texte_secondaire"
            android:textSize="12sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/carteSelectionBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fabricant"
                    android:textColor="@color/texte_principal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerFabricantBase"
                    android:layout_width="match_parent"
                    android:layout_height="46dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Gamme"
                    android:textColor="@color/texte_principal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerGammeBase"
                    android:layout_width="match_parent"
                    android:layout_height="46dp" />

                <TextView
                    android:id="@+id/txtAvertissementGammeBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/fond_carte"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="Couleurs"
                        android:textColor="@color/texte_principal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnToutCocherBase"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/fond_bouton_secondaire"
                        android:text="Tout cocher"
                        android:textColor="@color/texte_principal"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerCouleursBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnGenererTagsBase"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:visibility="gone"
            android:background="@drawable/fond_bouton_principal"
            android:text="Générer le(s) tag(s) sélectionné(s)"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
